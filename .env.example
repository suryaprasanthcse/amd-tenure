# Copy to .env and fill in. .env is git-ignored; never commit real keys (master §26.2).
# Setting TENURE_LLM_API_KEY=mock_key runs the T00 llm tests against an in-process mock endpoint
# (decision D-llm-mock). That does NOT verify spike S1.

# AMD Token Factory (default profile)
TENURE_LLM_BASE_URL=
TENURE_LLM_API_KEY=
TENURE_LLM_MODEL=

# Self-hosted vLLM on an AMD Developer Cloud MI300X droplet
TENURE_VLLM_BASE_URL=
TENURE_VLLM_API_KEY=
TENURE_VLLM_MODEL=

# Gated Gemma download on the droplet
HF_TOKEN=

# Bearer token for override and run endpoints
TENURE_ADMIN_TOKEN=

# Optional: the web build shows a "Live" toggle when set
VITE_LIVE_URL=

# Optional path overrides (defaults come from tenure.yaml)
# TENURE_RAW_DIR=
# TENURE_DERIVED_DIR=
# TENURE_GOLD_DIR=
# TENURE_OUTCOMES_DB=
# TENURE_LEDGER_DB=
# TENURE_RUNS_DIR=
# TENURE_PROFILE=
